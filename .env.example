APP_NAME="XPanel Host"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PAGESPEED_API_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Motor inicial para sitios nuevos; Apache y OpenLiteSpeed son opcionales.
XPANEL_WEB_SERVER=nginx
XPANEL_MANAGEMENT_MODE=standalone
# XPanel VPS sets these values for isolated managed instances. Do not set the
# instance root manually; it must live below /var/lib/xpanel-vps/instances.
# XPANEL_INSTANCE_ID=01234567-89ab-cdef-0123-456789abcdef
# XPANEL_INSTANCE_ROOT=/var/lib/xpanel-vps/instances/01234567-89ab-cdef-0123-456789abcdef
# XPANEL_CONTROL_PLANE_URL=https://host.example.com/admin
# XPANEL_BROKER_URL=https://host.example.com/api/internal/host-broker
# XPANEL_BROKER_SECRET=
# XPANEL_WEB_ROOT=/var/www/xpanel-instances/01234567-89ab-cdef-0123-456789abcdef
XPANEL_PANEL_DOMAIN=
XPANEL_APPLY_SYSTEM_CHANGES=false
XPANEL_SITE_HELPER=
XPANEL_SITE_USER=www-data
XPANEL_SITE_GROUP=www-data
XPANEL_BACKUP_ROOT=
XPANEL_ACME_EMAIL=
XPANEL_MAIL_HOSTNAME=
XPANEL_WEBMAIL_HOSTNAME=
XPANEL_WEBMAIL_URL=
XPANEL_ROUNDCUBE_ENABLED=true
XPANEL_XMAIL_ENABLED=true
XPANEL_XMAIL_ATTACHMENT_MAX_BYTES=52428800
XPANEL_PHPMYADMIN_ENABLED=true
XPANEL_MAIL_UID=5000
XPANEL_MAIL_GID=5000
XPANEL_SERVER_IPV4=
XPANEL_DKIM_SELECTOR=xpanel
XPANEL_PHP_VERSIONS=8.1,8.2,8.3,8.4
XPANEL_NODE_VERSIONS=22
# Real per-site terminal (see agent/README.md). Off by default; install.sh
# The agent uses opaque, single-use tokens stored and consumed by Laravel.
XPANEL_TERMINAL_ENABLED=false
# XPANEL_TERMINAL_AGENT_HOST=127.0.0.1
# XPANEL_TERMINAL_AGENT_PORT=7092
# XPANEL_TERMINAL_INTERNAL_PORT=7091
# XPANEL_TERMINAL_SERVICE_USER=xpanel-terminal
# Only set these values when this Host installation is provisioned by XPanel VM.
# XPANEL_MANAGEMENT_MODE=vm
# XPANEL_VM_URL=https://vm.example.com/panel
# XPANEL_VM_SERVICE_ID=ord_example
# XPANEL_ASSIGNED_CPU=2
# XPANEL_ASSIGNED_MEMORY_MIB=2048
# XPANEL_ASSIGNED_DISK_GIB=50

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
